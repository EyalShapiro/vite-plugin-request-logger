{
  "name": "vite-plugin-request-logger",
  "version": "1.0.0",
  "description": "A robust, Morgan-like HTTP request logger plugin for Vite supporting Vite 5, 6, 7, 8+ with body logging and TypeScript support.",
  "type": "module",
  "author": "Eyal Shapiro",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "example:advanced": "cd example/advanced && npm run dev"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "logger",
    "morgan",
    "http-logger",
    "request-logger",
    "typescript",
    "vite-plugin-morgan",
    "vite-logger"
  ],
  "dependencies": {
    "axios": "^1.19.0"
  }
}
