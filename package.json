{
  "name": "vite-plugin-request-logger",
  "version": "1.2.0",
  "description": "A robust, Morgan-like HTTP request logger plugin for Vite supporting Vite 5, 6, 7, 8+ with body logging and TypeScript support.",
  "type": "module",
  "author": "Eyal Shapiro",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/vite-plugin-request-logger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EyalShapiro/vite-plugin-request-logger.git"
  },
  "bugs": {
    "url": "https://github.com/EyalShapiro/vite-plugin-request-logger/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "cd example/advanced && npx tsc --noEmit && cd ../custom-features && npx tsc --noEmit",
    "test:all": "npm run typecheck && npm run typecheck:examples && npm test",
    "example:advanced": "cd example/advanced && npm run dev",
    "example:custom": "cd example/custom-features && npm run dev",
    "prepublishOnly": "npm run build && npm run test",
    "publish:all": "npm publish",
    "version:patch": "npm run prepublishOnly && npm version patch && npm run publish:all",
    "version:minor": "npm run prepublishOnly && npm version minor && npm run publish:all",
    "version:major": "npm run prepublishOnly && npm version major && npm run publish:all"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "logger",
    "morgan",
    "http-logger",
    "request-logger",
    "typescript",
    "vite-plugin-morgan",
    "vite-logger",
    "api-logger",
    "dev-server-logger",
    "middleware-logger",
    "vite-dev-logger",
    "vite-morgan"
  ]
}
